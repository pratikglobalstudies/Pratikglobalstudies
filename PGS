}

.section-title {
  text-align: center;
  color: var(--blue);
  font-size: 28px;
  margin-bottom: 25px;
}

.about {
  background: white;
  text-align: center;
}

.about p {
  max-width: 850px;
  margin: auto;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.card {
  background: white;
  padding: 22px;
  border-radius: 12px;
  box-shadow: 0 3px 12px rgba(0,0,0,.08);
  text-align: center;
