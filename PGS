}

.hero h2 {
  font-size: 34px;
  margin-bottom: 10px;
}

.hero p {
  max-width: 700px;
  margin: auto;
}

.recognized {
  display: inline-block;
  background: var(--yellow);
  color: #222;
  padding: 7px 18px;
  border-radius: 20px;
  font-weight: bold;
  margin-top: 18px;
}

.slider {
  max-width: 1100px;
  margin: 25px auto;
  padding: 0 15px;
  position: relative;
}

.slider img {
  width: 100%;
  height: 430px;
  object-fit: cover;
  border-radius: 12px;
  display: none;
}

.slider img.active {
  display: block;
}

.slider-btn {
  position: absolute;
  top: 45%;
  background: rgba(0,0,0,.65);
  color: white;
  border: none;
  padding: 12px 16px;
  cursor: pointer;
  border-radius: 5px;
  font-size: 20px;
}

.prev {
  left: 25px;
}

.next {
  right: 25px;
}

